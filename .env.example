# 값을 채워 .env로 복사한다. .env는 절대 커밋하지 않는다 (SPEC N7).

# ── OpenDART (opendart.fss.or.kr → 인증키 신청, 40자, 무료, 일 20,000회) ──
# 키는 URL 쿼리에 실린다. 로그·예외 메시지에 URL을 통째로 찍지 않는다.
DART_API_KEY=

# ── Anthropic (console.anthropic.com) — F14 요약. 없으면 요약 없이 돌고 메일에 "⚠ 요약 생성 실패(키 없음)"가 붙는다 ──
ANTHROPIC_API_KEY=

# ── 네이버 검색 API (F11 뉴스, M1c) — 둘 중 한 쌍만 채운다 ──
# A. NAVER API Hub (권장) — https://www.ncloud.com → NAVER API Hub → 검색 API 이용신청
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
# B. 네이버 개발자센터 (즉시 발급·카드 불필요, 2027-06-30 지원 종료)
#    https://developers.naver.com/apps/#/register → 사용 API "검색" → 비로그인 오픈 API WEB 설정
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# 처리한도 25,000회/일. 이 배치는 하루 최대 15회(등급 none인 종목만) 쓴다.

# ── Supabase (krx-signal-alerts와 같은 프로젝트 — 상위 .env와 동일한 값) ──
# service key는 RLS를 우회한다. ksa_*/ksc_*는 읽기만, 쓰기는 ksb_*뿐.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 스키마 적용(DDL)·psycopg 조회용. 트랜잭션 풀러(6543) URL.
SUPABASE_DATABASE_URL=

# ── Gmail SMTP (상위와 동일 — 계정 비밀번호가 아니라 앱 비밀번호) ──
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 수신자 — 본인 1명만 (SPEC R7 유사투자자문 경계). 쉼표 구분 가능하나 늘리지 않는다.
RECIPIENTS=
